{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StructuredClinicalReportV2Spans",
  "type": "object",
  "required": ["symptoms", "diagnoses", "medications", "assessment_summary", "evidence"],
  "additionalProperties": false,
  "properties": {
    "symptoms": { "type": "array", "items": { "type": "string" } },
    "diagnoses": { "type": "array", "items": { "type": "string" } },
    "medications": { "type": "array", "items": { "type": "string" } },
    "assessment_summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "item", "start", "end"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "enum": ["symptoms", "diagnoses", "medications", "assessment_summary"] },
          "item": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}